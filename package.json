{
  "name": "tera-oms",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=dispatcher-web",
    "build": "npm run build --workspace=dispatcher-web",
    "lint": "npm run lint --workspace=dispatcher-web",
    "test": "npm run test --workspace=dispatcher-web",
    "boundaries": "depcruise --config .dependency-cruiser.cjs services/api/src"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "dependency-cruiser": "^16.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}